#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Copyright (C) 2022-2023 ImmortalWrt.org
#
# PR-05 (PHASE 7): this file is the lifecycle orchestrator only.  Everything
# that is not "read the configuration, decide, and drive procd" now lives in
# /etc/homeproxy/scripts/runtime/:
#
#   config.sh    generated-configuration transaction (known-good, restore,
#                rollback) - pure, takes explicit paths
#   health.sh    instance health probe - pure w.r.t. procd, stubbable
#   service.sh   sing-box version gate, auto-update cron, runtime-file
#                preparation, procd instance registration, the
#                generate->known-good transaction
#   dns.sh       dnsmasq snippet directory, snippet writing, teardown
#   firewall.sh  fw4 pre/post scripts, reload, owned-object teardown, upnp
#   net.sh       tproxy / TUN ip rules and routes, teardown
#
# What deliberately stays here: USE_PROCD and the start/stop/reload/
# service_triggers skeletons, the configuration reads that choose between
# client, server and neither, and the ordering that makes a reload safe
# (generate first, tear down later, prove it came up, roll back otherwise).
#
# ABSOLUTE RULE 3 of docs/homeproxy_architecture_refactor_agent_guide.md
# applies: this is a behaviour-preserving extraction.  Log lines, command
# order, exit codes and file paths are unchanged.

USE_PROCD=1

START=99
STOP=10

CONF="homeproxy"
PROG="/usr/bin/sing-box"

HP_DIR="/etc/homeproxy"
RUN_DIR="/var/run/homeproxy"
LOG_PATH="$RUN_DIR/homeproxy.log"

# Last configuration that passed `sing-box check` and started successfully.
# start_service falls back to it when a regeneration fails, and
# reload_service restores it when a reload does not come up.
GOOD_DIR="$RUN_DIR/known-good"

# fw4 chain/set inventory; single source of truth shared with firewall_post.ut
[ -f "$HP_DIR/scripts/fw4_names.sh" ] && . "$HP_DIR/scripts/fw4_names.sh"

# Configuration transaction (known-good copy, restore, rollback) and the
# health probe that decides whether a reload needs to roll back.
[ -f "$HP_DIR/scripts/runtime/config.sh" ] && . "$HP_DIR/scripts/runtime/config.sh"
[ -f "$HP_DIR/scripts/runtime/health.sh" ] && . "$HP_DIR/scripts/runtime/health.sh"

# Device-side orchestration extracted by PR-05.
[ -f "$HP_DIR/scripts/runtime/service.sh" ] && . "$HP_DIR/scripts/runtime/service.sh"
[ -f "$HP_DIR/scripts/runtime/dns.sh" ] && . "$HP_DIR/scripts/runtime/dns.sh"
[ -f "$HP_DIR/scripts/runtime/firewall.sh" ] && . "$HP_DIR/scripts/runtime/firewall.sh"
[ -f "$HP_DIR/scripts/runtime/net.sh" ] && . "$HP_DIR/scripts/runtime/net.sh"

log() {
	echo -e "$(date "+%Y-%m-%d %H:%M:%S") [DAEMON] $*" >> "$LOG_PATH"
}

# Resolve the dnsmasq snippet directory once, at load time.  stop_service
# reuses the stored value rather than recomputing it, so a dnsmasq
# reconfiguration between start and stop cannot make it delete the wrong
# directory (see runtime/dns.sh).
hp_dnsmasq_resolve_dir

start_service() {
	config_load "$CONF"

	hp_require_singbox || return 1

	local routing_mode proxy_mode outbound_node server_enabled
	config_get routing_mode "config" "routing_mode" "bypass_mainland_china"
	config_get proxy_mode "config" "proxy_mode" "redirect_tproxy"

	if [ "$routing_mode" != "custom" ]; then
		config_get outbound_node "config" "main_node" "nil"
	else
		config_get outbound_node "routing" "default_outbound" "nil"
	fi

	config_get_bool server_enabled "server" "enabled" "0"

	if [ "$outbound_node" = "nil" ] && [ "$server_enabled" = "0" ]; then
		log "Neither client nor server is configured. Service not started."
		return 1
	fi

	local client_enabled=0
	[ "$outbound_node" = "nil" ] || client_enabled=1

	mkdir -p "$RUN_DIR"

	local disable_gso=0
	uname -r | grep -Eq "^6\.6" && disable_gso=1

	if [ "$client_enabled" = "1" ]; then
		hp_net_wait_wan 60

		hp_start_generated_config c "$HP_DIR" "$RUN_DIR" "$GOOD_DIR" || return 1

		local auto_update auto_update_time
		config_get_bool auto_update "subscription" "auto_update" "0"
		config_get auto_update_time "subscription" "auto_update_time" "2"
		hp_sync_autoupdate_cron "$auto_update" "$auto_update_time"

		hp_dnsmasq_write_snippets "$DNSMASQ_DIR" "$HP_DIR" "$routing_mode"
		hp_net_setup "$proxy_mode" "$routing_mode"

		hp_procd_client_instance "$PROG" "$HP_DIR" "$RUN_DIR" "$routing_mode" "$disable_gso"
	fi

	if [ "$server_enabled" = "1" ]; then
		hp_start_generated_config s "$HP_DIR" "$RUN_DIR" "$GOOD_DIR" || return 1

		hp_procd_server_instance "$PROG" "$HP_DIR" "$RUN_DIR" "$disable_gso"
	fi

	hp_procd_log_cleaner "$HP_DIR"

	hp_prepare_runtime_files "$HP_DIR" "$RUN_DIR" "$routing_mode" "$client_enabled" "$server_enabled"

	hp_firewall_apply "$HP_DIR" "$RUN_DIR" "$client_enabled"

	log "sing-box $(sing-box version -n 2>/dev/null || echo "unknown") started."
}

stop_service() {
	hp_clear_autoupdate_cron

	config_load "$CONF"

	hp_net_teardown
	hp_firewall_teardown "$RUN_DIR"
	hp_dnsmasq_remove_snippets "$DNSMASQ_DIR"

	rm -f "$RUN_DIR/sing-box-c.json" "$RUN_DIR/sing-box-c.log" \
		"$RUN_DIR/sing-box-s.json" "$RUN_DIR/sing-box-s.log"

	log "Service stopped."
}

service_stopped() {
	config_load "$CONF"

	hp_net_remove_tun
}

reload_service() {
	log "Reloading service..."

	config_load "$CONF"
	local routing_mode
	config_get routing_mode "config" "routing_mode" "bypass_mainland_china"

	local outbound_node
	if [ "$routing_mode" != "custom" ]; then
		config_get outbound_node "config" "main_node" "nil"
	else
		config_get outbound_node "routing" "default_outbound" "nil"
	fi

	# Generate first, tear down later.  If the new configuration is invalid
	# the generator leaves the running one in place, so the reload is
	# aborted *before* stop_service() - the old configuration keeps running
	# instead of the router ending up with no service at all.
	if [ "$outbound_node" != "nil" ]; then
		if ! ucode -S "$HP_DIR/scripts/generate_client.uc" 2>>"$LOG_PATH"; then
			log "Error: new client configuration is invalid, reload aborted; the running configuration is kept."
			return 1
		fi
	fi

	local server_enabled
	config_get_bool server_enabled "server" "enabled" "0"
	if [ "$server_enabled" = "1" ]; then
		if ! ucode -S "$HP_DIR/scripts/generate_server.uc" 2>>"$LOG_PATH"; then
			log "Error: new server configuration is invalid, reload aborted; the running configuration is kept."
			return 1
		fi
	fi

	# Both configurations passed `sing-box check`; now it is safe to restart.
	# The known-good copy is deliberately NOT refreshed yet: it still holds
	# the previous configuration, which is what a failed reload rolls back
	# to.
	stop
	start

	# ... and now prove the instances actually came up.  A configuration can
	# pass check and still fail at run time; without this gate the router
	# would silently stay down because stop_service() removed the previous
	# files.
	local failed=""
	if [ "$outbound_node" != "nil" ]; then
		hp_wait_instance "sing-box-c" "$RUN_DIR/sing-box-c.json" 10 || failed="sing-box-c"
	fi
	if [ "$server_enabled" = "1" ] && [ -z "$failed" ]; then
		hp_wait_instance "sing-box-s" "$RUN_DIR/sing-box-s.json" 10 || failed="sing-box-s"
	fi

	if [ -z "$failed" ]; then
		# The new configuration is proven good; record it as the fallback.
		[ "$outbound_node" = "nil" ] || hp_known_good "$RUN_DIR/sing-box-c.json" "$GOOD_DIR/sing-box-c.json"
		[ "$server_enabled" != "1" ] || hp_known_good "$RUN_DIR/sing-box-s.json" "$GOOD_DIR/sing-box-s.json"
		log "Reload completed."
		return 0
	fi

	log "Error: $failed did not come up with the new configuration, rolling back."

	local good="$GOOD_DIR/$failed.json"
	local live="$RUN_DIR/$failed.json"
	local rolled_back=0

	if hp_same_file "$live" "$good"; then
		log "Error: the failing configuration is already the known-good one; nothing to roll back to."
	elif hp_rollback "$live" "$good"; then
		rolled_back=1
	else
		log "Error: no known-good configuration to roll back to."
	fi

	if [ "$rolled_back" = "0" ]; then
		log "Error: rollback was not possible; the service may be down. Check $LOG_PATH."
		return 1
	fi

	# Start from the recorded file rather than regenerating: the generator
	# is a pure function of UCI, so it would rebuild the config that just
	# failed.
	HP_USE_KNOWN_GOOD=1
	export HP_USE_KNOWN_GOOD

	stop
	start

	if hp_wait_instance "$failed" "$RUN_DIR/$failed.json" 10; then
		log "Rollback completed; the previous configuration is running."
		return 0
	fi

	log "Error: rollback did not restore the service; manual intervention required."
	return 1
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/$CONF reload
}
